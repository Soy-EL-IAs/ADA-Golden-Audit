{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada-experimental://m1/concept_proposals_v1",
  "title": "M1 Creative Expansion Lab output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "concepts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "snapshot": {"type": "string", "minLength": 1},
          "visual_hook": {"type": "string", "minLength": 1},
          "provocative_mechanism": {"type": "string", "minLength": 1},
          "composition_intent": {"type": "string", "minLength": 1},
          "diversity_signature": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "setting": {"type": "string", "minLength": 1},
              "framing": {"type": "string", "minLength": 1},
              "attitude": {"type": "string", "minLength": 1},
              "visual_emphasis": {"type": "string", "minLength": 1}
            },
            "required": ["setting", "framing", "attitude", "visual_emphasis"]
          }
        },
        "required": [
          "concept_id",
          "snapshot",
          "visual_hook",
          "provocative_mechanism",
          "composition_intent",
          "diversity_signature"
        ]
      }
    }
  },
  "required": ["concepts"]
}
