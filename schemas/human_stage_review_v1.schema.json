{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Human Stage Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "asset_id", "created_at", "stage", "status", "rating", "supersedes_review_id"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["human_stage_review_v1"]},
    "review_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["illustrious", "klein", "lustify", "miaomiao"]},
    "status": {"type": "string", "enum": ["UNREVIEWED", "APPROVED", "REJECTED"]},
    "rating": {"type": "integer", "minimum": 0, "maximum": 10},
    "supersedes_review_id": {"type": "string"}
  }
}
