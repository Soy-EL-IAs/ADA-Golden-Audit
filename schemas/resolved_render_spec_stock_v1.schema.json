{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Resolved Stock Render Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "spec_id", "character_contract_id", "concept_id",
    "creation_mode", "character_id", "character", "outfit",
    "stock_policy_version", "stock_render_policy", "scene_requirements",
    "composition_intent", "validation_requirements", "risk_notes",
    "render_intent", "render_mode", "render_policy_version",
    "environment_anchors", "expected_visibility", "expected_subject_count"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["resolved_render_spec_stock_v1"]},
    "spec_id": {"type": "string", "minLength": 1},
    "character_contract_id": {"type": "string", "minLength": 1},
    "concept_id": {"type": "string", "minLength": 1},
    "creation_mode": {"type": "string", "enum": ["stock"]},
    "character_id": {"type": "string", "minLength": 1},
    "character": {"type": "object"},
    "outfit": {"type": "object"},
    "outfit_override": {"type": "string", "minLength": 1},
    "stock_policy_version": {"type": "string", "enum": ["stock_v1"]},
    "stock_render_policy": {"type": "object"},
    "scene_requirements": {"type": "array", "maxItems": 0},
    "composition_intent": {"type": "string", "minLength": 1},
    "validation_requirements": {"type": "array", "items": {"type": "object"}},
    "risk_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "render_intent": {"type": "string", "enum": ["anime", "semi_realistic", "photorealistic"]},
    "render_mode": {"type": "string", "enum": ["DIRECT_T2I"]},
    "render_policy_version": {"type": "string", "enum": ["stock_v1"]},
    "environment_anchors": {"type": "array", "maxItems": 0},
    "expected_visibility": {"type": "array", "items": {"type": "string", "minLength": 1}}
    ,"expected_subject_count": {"type": "integer", "minimum": 1, "maximum": 1}
  }
}
