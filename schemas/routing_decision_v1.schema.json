{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Routing Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "observation_id", "stage", "attempt", "action", "reason", "correction_delta", "routing_policy_version"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["routing_decision_v1"]},
    "decision_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["illustrious", "klein", "lustify", "miaomiao"]},
    "attempt": {"type": "integer", "minimum": 1},
    "action": {"type": "string", "enum": ["ADVANCE_TO_KLEIN", "RETRY_ILLUSTRIOUS", "RETRY_KLEIN", "APPROVE", "REJECT"]},
    "reason": {"type": "string"},
    "correction_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_stage", "instructions"],
      "properties": {
        "target_stage": {"type": "string", "enum": ["none", "illustrious", "klein"]},
        "instructions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "routing_policy_version": {"type": "string", "minLength": 1}
  }
}
