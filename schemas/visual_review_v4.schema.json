{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Visual Review v4 grounded compact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outfit_design_adherence",
    "identity_comparison",
    "reference_observations",
    "candidate_observations",
    "id",
    "stage",
    "identity",
    "subject_count",
    "scores",
    "defects",
    "hard_constraint_failures",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "illustrious",
        "klein",
        "lustify",
        "miaomiao"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "score",
        "confidence"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "subject_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "actual",
        "result"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 1
        },
        "actual": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anatomy",
        "prompt_adherence",
        "composition",
        "visual_quality"
      ],
      "properties": {
        "anatomy": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "prompt_adherence": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "composition": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "visual_quality": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "defects": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "hard_constraint_failures": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "candidate_observations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "reference_observations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "identity_comparison": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "outfit_design_adherence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    }
  }
}
