{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada://schemas/minimax_result_v1",
  "title": "MiniMaxResult v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "workflow_mode": {"type": "string", "enum": ["F2V", "I2V", "REF2V"]},
    "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "video_prompt": {"type": "string", "minLength": 1},
    "continuity_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": ["id", "workflow_mode", "duration_seconds", "video_prompt", "continuity_constraints"]
}
