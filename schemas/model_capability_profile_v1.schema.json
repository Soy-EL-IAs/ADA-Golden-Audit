{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Model Capability Profile v1",
  "type": "object",
  "required": ["schema_version", "model_id", "physical_type", "family", "architecture", "loader", "capabilities", "test_status", "test_recipe"],
  "properties": {
    "schema_version": {"const": "model_capability_profile_v1"},
    "model_id": {"type": "string"},
    "physical_type": {"enum": ["checkpoint", "adapter", "lora", "text_encoder", "vae", "unknown"]},
    "family": {"type": "string"},
    "architecture": {"type": "string"},
    "loader": {"type": "object"},
    "capabilities": {"type": "object"},
    "test_status": {"enum": ["not_tested", "tested", "production_baseline", "production_primary", "production_secondary_optional", "failed"]},
    "test_recipe": {"type": "object"}
  }
}
