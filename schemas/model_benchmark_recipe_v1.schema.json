{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Model Benchmark Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "recipe_id", "recipe_version", "model_id", "role",
    "status", "workflow", "loader", "prompt_style", "resolution",
    "sampling", "negative_prompt", "dependencies", "bindings", "notes"
  ],
  "properties": {
    "schema_version": {"const": "model_benchmark_recipe_v1"},
    "recipe_id": {"type": "string", "minLength": 1},
    "recipe_version": {"type": "integer", "minimum": 1},
    "model_id": {"type": "string", "minLength": 1},
    "role": {"const": "direct_anime_generator"},
    "status": {"enum": ["benchmark_ready", "blocked", "retired"]},
    "workflow": {
      "type": "object",
      "required": ["api_template", "source_evidence", "output_node"],
      "properties": {
        "api_template": {"type": "string", "minLength": 1},
        "source_evidence": {"type": "string", "minLength": 1},
        "output_node": {"type": "string", "minLength": 1}
      }
    },
    "loader": {"type": "object"},
    "prompt_style": {"enum": ["descriptive", "booru_tags", "hybrid"]},
    "resolution": {
      "type": "object",
      "required": ["width", "height", "batch_size"],
      "properties": {
        "width": {"type": "integer", "minimum": 64},
        "height": {"type": "integer", "minimum": 64},
        "batch_size": {"const": 1}
      }
    },
    "sampling": {"type": "object"},
    "negative_prompt": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "bindings": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
