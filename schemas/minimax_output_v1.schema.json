{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada://schemas/minimax_output_v1",
  "title": "MiniMaxOutput v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hook_contract": {
      "type": "object",
      "properties": {
        "visual_hook": {"type": "string"},
        "motion_trigger": {"type": "string"},
        "escalation": {"type": "string"},
        "payoff": {"type": "string"},
        "end_state": {"type": "string"}
      },
      "required": ["visual_hook", "motion_trigger", "escalation", "payoff", "end_state"],
      "additionalProperties": false
    },
    "video_prompt": {"type": "string", "minLength": 1}
  },
  "required": ["hook_contract", "video_prompt"]
}
