{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada://schemas/klein_result_v1",
  "title": "KleinResult v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "klein_prompt": {"type": "string", "minLength": 1},
    "preserve": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "correct": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": ["id", "klein_prompt", "preserve", "correct"]
}
