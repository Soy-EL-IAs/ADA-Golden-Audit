{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Model Test Receipt v1",
  "type": "object",
  "required": ["schema_version", "run_id", "model_id", "model_version", "checkpoint", "adapters", "workflow", "character", "task", "status", "started_at", "input_asset", "prompt", "seed", "configuration", "vram", "result"],
  "properties": {
    "schema_version": {"const": "model_test_receipt_v1"},
    "run_id": {"type": "string"},
    "model_id": {"type": "string"},
    "model_version": {"type": ["string", "null"]},
    "checkpoint": {"type": ["string", "null"]},
    "adapters": {"type": "array"},
    "workflow": {"type": ["string", "null"]},
    "recipe_id": {"type": "string"},
    "recipe_version": {"type": "integer"},
    "character": {"type": "string"},
    "character_contract": {"type": "string"},
    "task": {"type": "string"},
    "status": {"enum": ["RUNNING", "COMPLETE", "FAILED"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "input_asset": {"type": "string"},
    "output_asset": {"type": ["string", "null"]},
    "prompt": {"type": "string"},
    "seed": {"type": "integer"},
    "configuration": {"type": "object"},
    "duration_seconds": {"type": ["number", "null"]},
    "inference_seconds": {"type": ["number", "null"]},
    "job_size": {"const": 1},
    "vram": {"type": "object"},
    "result": {"type": "object"},
    "error": {"type": ["string", "null"]}
  }
}
