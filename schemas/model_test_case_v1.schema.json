{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Model Test Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "test_id", "benchmark_id", "character", "character_contract", "source_asset", "task", "role", "models", "prompt", "seed", "evaluation_dimensions", "status"],
  "properties": {
    "schema_version": {"const": "model_test_case_v1"},
    "test_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "character": {"type": "string", "minLength": 1},
    "character_contract": {"type": "string", "minLength": 1},
    "source_asset": {"type": "string"},
    "task": {"type": "string", "minLength": 1},
    "role": {"enum": ["identity_constructor", "anime_to_real_converter", "photorealistic_generator", "style_preserver", "direct_anime_generator"]},
    "models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prompt": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "scene_intent": {"type": "string"},
    "recipe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recipe_prompts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "character_contract_snapshot": {"type": "string"},
    "evaluation_dimensions": {
      "type": "array",
      "items": {"enum": ["identity_preservation", "face_similarity", "expression_preservation", "outfit_preservation", "composition_preservation", "realism_quality", "skin_quality", "hairstyle_preservation", "eye_color_preservation", "pose_anatomy", "environment_quality", "prompt_adherence", "visual_appeal", "overall"]}
    },
    "status": {"enum": ["READY", "BLOCKED", "IN_PROGRESS", "COMPLETE", "FAILED"]}
  }
}
