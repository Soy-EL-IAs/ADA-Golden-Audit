{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Model Evaluation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "benchmark_id", "test_id", "run_id", "model_id", "character", "role", "created_at", "evaluator", "scores", "notes"],
  "properties": {
    "schema_version": {"const": "model_evaluation_receipt_v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "character": {"type": "string", "minLength": 1},
    "role": {"enum": ["identity_constructor", "anime_to_real_converter", "photorealistic_generator", "style_preserver", "direct_anime_generator"]},
    "recipe_id": {"type": ["string", "null"]},
    "recipe_version": {"type": ["integer", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "evaluator": {"enum": ["human"]},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity_preservation": {"type": "integer", "minimum": 1, "maximum": 10},
        "face_similarity": {"type": "integer", "minimum": 1, "maximum": 10},
        "expression_preservation": {"type": "integer", "minimum": 1, "maximum": 10},
        "outfit_preservation": {"type": "integer", "minimum": 1, "maximum": 10},
        "composition_preservation": {"type": "integer", "minimum": 1, "maximum": 10},
        "realism_quality": {"type": "integer", "minimum": 1, "maximum": 10},
        "skin_quality": {"type": "integer", "minimum": 1, "maximum": 10},
        "hairstyle_preservation": {"type": "integer", "minimum": 1, "maximum": 10},
        "eye_color_preservation": {"type": "integer", "minimum": 1, "maximum": 10},
        "pose_anatomy": {"type": "integer", "minimum": 1, "maximum": 10},
        "environment_quality": {"type": "integer", "minimum": 1, "maximum": 10},
        "prompt_adherence": {"type": "integer", "minimum": 1, "maximum": 10},
        "visual_appeal": {"type": "integer", "minimum": 1, "maximum": 10},
        "overall": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "notes": {"type": "string"}
  }
}
