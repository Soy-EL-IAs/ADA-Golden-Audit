{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ada://schemas/premise_spec_v1",
  "title": "PremiseSpec v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "premise": {"type": "string", "minLength": 1},
    "preserved_elements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "identity_elements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "canonical_outfit": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "scene_requirements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "risk_notes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": ["id", "category", "premise", "risk_notes"]
}
