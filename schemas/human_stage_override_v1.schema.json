{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Human Stage Override v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "override_id", "asset_id", "created_at", "selected_stage", "reason", "automatic_decision_id", "supersedes_override_id"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["human_stage_override_v1"]},
    "override_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "selected_stage": {"type": "string", "enum": ["illustrious", "klein", "lustify", "miaomiao", "none"]},
    "reason": {"type": "string", "minLength": 1},
    "automatic_decision_id": {"type": "string"},
    "supersedes_override_id": {"type": "string"}
  }
}
