{
  "policy_version": "character_reference_policy_v2",
  "discovery": {
    "max_queries": 6,
    "results_per_query": 20,
    "query_templates": [
      "\"{canonical_name}\" \"{franchise}\"",
      "\"{canonical_name}\" \"{franchise}\" character",
      "\"{canonical_name}\" \"{franchise}\" official artwork",
      "\"{canonical_tag}\""
    ]
  },
  "source_policy": {
    "inherit_trust_from_source_page": true,
    "tiers": {
      "official": {"trust": 100},
      "trusted": {"trust": 80},
      "curated_community": {"trust": 65, "requires_identity_verification": true},
      "unknown": {"trust": 40, "requires_identity_verification": true}
    },
    "domain_overrides": {}
  },
  "validation": {
    "minimum_identity_confidence": 0.70,
    "minimum_reference_utility": 0.45,
    "minimum_width": 320,
    "minimum_height": 320
  },
  "acceptance": {
    "strong_reference_confidence": 0.80,
    "limited_reference_count": 1,
    "ready_reference_count": 2
  },
  "max_searches": 2,
  "results_per_search": 30,
  "max_returned_refs": 12,
  "fallback_max_results_per_domain": 2,
  "final_max_results_per_domain": 2,
  "minimum_return_score": 55,
  "recommendation_thresholds": {
    "auto": 85,
    "review": 60
  },
  "minimum_character_relevance": 55,
  "score_weights": {
    "source_trust": 0.55,
    "character_relevance": 0.40,
    "image_quality": 0.05
  },
  "source_scores": {
    "official": 100,
    "unverified": 15
  },
  "official_domains": {
    "bandainamcoent.com": "Bandai Namco Entertainment",
    "bleach-anime.com": "Bleach anime",
    "capcom.com": "Capcom",
    "dc.com": "DC",
    "finalfantasy.com": "Final Fantasy",
    "heroaca.com": "My Hero Academia anime",
    "marvel.com": "Marvel",
    "mortalkombat.com": "Mortal Kombat",
    "naruto-official.com": "Naruto",
    "nintendo.com": "Nintendo",
    "one-piece.com": "One Piece",
    "playstation.com": "PlayStation",
    "platinumgames.com": "PlatinumGames",
    "residentevil.com": "Resident Evil",
    "sega.com": "SEGA",
    "snk-corp.co.jp": "SNK",
    "square-enix-games.com": "Square Enix",
    "streetfighter.com": "Street Fighter",
    "tombraider.com": "Tomb Raider",
    "warnerbrosgames.com": "Warner Bros. Games",
    "xbox.com": "Xbox",
    "mushokutensei.jp": "Mushoku Tensei",
    "crunchyroll.com": "Crunchyroll",
    "dragon-ball-official.com": "Dragon Ball Official",
    "perfectworld.com": "Perfect World / Neverness to Everness"
  },
  "trusted_domains": {
    "wikipedia.org": 75,
    "wikimedia.org": 80,
    "fandom.com": 70,
    "myanimelist.net": 70
  },
  "excluded_domains": [
    "pinterest.com",
    "pinterest.es",
    "pinimg.com",
    "deviantart.com",
    "civitai.com",
    "seaart.ai",
    "zerochan.net",
    "renderhub.com",
    "cgtrader.com",
    "pexels.com",
    "unsplash.com",
    "pixabay.com",
    "shutterstock.com",
    "istockphoto.com",
    "gettyimages.com",
    "stock.adobe.com",
    "freepik.com",
    "depositphotos.com",
    "dreamstime.com",
    "123rf.com",
    "alamy.com",
    "rawpixel.com",
    "stocksnap.io",
    "burst.shopify.com",
    "alphacoders.com",
    "rare-gallery.com"
  ],
  "excluded_terms": [
    "cosplay",
    "fanart",
    "fan art",
    "wallpaper",
    "ai generated",
    "ai-generated",
    "generated by ai",
    "stable diffusion",
    "midjourney",
    "novelai"
  ],
  "excluded_asset_terms": [
    "favicon",
    "icon",
    "loader",
    "loading",
    "logo",
    "placeholder",
    "spinner",
    "sprite",
    "thumb",
    "thumbnail"
  ],
  "generic_name_tokens": [
    "lady",
    "king",
    "lust",
    "poison",
    "power",
    "storm"
  ],
  "character_aliases": {
    "tifa lockhart": ["tifa"],
    "2b": ["yorha 2b", "yorha no 2 type b"]
  },
  "page_fetch": {
    "max_pages": 5,
    "max_bytes": 1000000,
    "timeout_seconds": 10,
    "follow_same_ecosystem_links": true,
    "canonical_link_terms": [
      "character",
      "media",
      "press",
      "gallery",
      "screenshot",
      "artwork",
      "render",
      "product"
    ]
  },
  "cache": {
    "minimum_refs": 2,
    "maximum_refs": 5,
    "timeout_seconds": 30,
    "max_image_bytes": 20000000
  },
  "resolution": {
    "preferred_min_width": 768,
    "preferred_min_height": 768,
    "minimum_pixels": 250000
  }
}
