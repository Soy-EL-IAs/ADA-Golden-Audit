{
  "enabled_by_default": false,
  "lm_studio_url": "http://127.0.0.1:1234",
  "api_token_env": "LM_STUDIO_API_TOKEN",
  "models": {
    "master": {
      "model": "qwen3.8-27b-uncensored",
      "role": "MASTER / SMART",
      "context_length": 16384,
      "eval_batch_size": 2048,
      "physical_batch_size": 512,
      "parallel": 1,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "speculative_draft_mtp": true,
      "speculative_draft_max_tokens": 1,
      "speculative_draft_min_tokens": 0,
      "speculative_draft_min_continue_probability": 0.75,
      "reasoning_budget": 512,
      "mtp": true,
      "ttl_seconds": 900
    },
    "worker": {
      "model": "qwen/qwen3-vl-8b",
      "role": "VISION WORKER",
      "context_length": 8192,
      "eval_batch_size": 2048,
      "parallel": 1,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "ttl_seconds": 300
    },
    "premise_agent": {
      "model": "qwen3.5-9b-uncensored-hauhaucs-aggressive",
      "role": "PREMISE SPECIALIST",
      "context_length": 16384,
      "eval_batch_size": 2048,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "ttl_seconds": 300
    },
    "illustrious_agent": {
      "model": "qwen3.5-9b-uncensored-hauhaucs-aggressive",
      "role": "ILLUSTRIOUS SPECIALIST",
      "context_length": 8192,
      "eval_batch_size": 2048,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "ttl_seconds": 300
    },
    "klein_agent": {
      "model": "qwen3.5-9b-uncensored-hauhaucs-aggressive",
      "role": "KLEIN SPECIALIST",
      "context_length": 8192,
      "eval_batch_size": 2048,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "ttl_seconds": 300
    },
    "minimax_agent": {
      "model": "qwen3.5-9b-uncensored-hauhaucs-aggressive",
      "role": "MINIMAX SPECIALIST",
      "context_length": 12288,
      "eval_batch_size": 2048,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "ttl_seconds": 300
    },
    "visual_review_worker": {
      "model": "qwen/qwen3-vl-8b",
      "role": "VISUAL REVIEW SPECIALIST",
      "context_length": 8192,
      "eval_batch_size": 2048,
      "flash_attention": true,
      "offload_kv_cache_to_gpu": true,
      "ttl_seconds": 300
    }
  },
  "vram_release": {
    "timeout_seconds": 90,
    "poll_seconds": 2,
    "comfy_min_free_ratio": 0.75
  }
}
